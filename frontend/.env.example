# Base URL of the Spring Boot backend. In dev the Vite proxy forwards /api to
# http://localhost:8080, so the relative default below is usually correct.
VITE_API_BASE_URL=/api/v1

# Demo mode. Turns on the clearly labelled fixture adapters for the four capabilities
# that have no backend endpoint at all: team workload / overloaded employees, manager
# capacity and AI analytics, notifications, and the assignment-candidate ranking read
# path. Every real endpoint is always used regardless of this flag.
# See docs/phase7-api-gaps.md and docs/demo-mode.md.
VITE_DEMO_MODE=true

# Organisation label shown in the shell. Cosmetic only.
VITE_ORG_NAME=NovaTech
