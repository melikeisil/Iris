# LLM_PROVIDER=auto prefers Gemini, then Anthropic, when a key is set and reachable at
# startup; otherwise it falls back to the deterministic mock. Set explicitly to force one.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

# Shared secret with Spring Boot. Required in every environment - the service refuses to
# start without it, the same way the backend refuses to start with a weak JWT secret.
SERVICE_TOKEN=dev-only-service-token-change-me

PROMPT_VERSION=v1
LOG_LEVEL=INFO
LOG_FORMAT=json
SANITIZER_STRICT=true
MAX_DESCRIPTION_CHARS=20000
