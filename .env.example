# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# ---- Profiles -------------------------------------------------------------
# dev   - relaxed secret validation, SQL logging
# demo  - seeds the Acme organization, departments, teams, skills and 20 users
# prod  - strict; StartupSecretValidator refuses to boot on a weak JWT_SECRET
SPRING_PROFILES_ACTIVE=dev,demo

# ---- Database -------------------------------------------------------------
DATABASE_NAME=smartwork
DATABASE_USER=smartwork
DATABASE_PASSWORD=smartwork
DATABASE_PORT=5432

# ---- Backend --------------------------------------------------------------
BACKEND_PORT=8080

# Minimum 64 bytes for HS512. Generate one with:
#   openssl rand -base64 64 | tr -d '\n'
# Leave blank under the dev profile to use the built-in development secret.
JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Password shared by every seeded demo account. Demo profile only.
DEMO_PASSWORD=SmartWork!Demo2026

# ---- Frontend -------------------------------------------------------------
FRONTEND_PORT=5173
# Demo fixtures for capabilities with no backend endpoint yet (sprints, analytics,
# notifications, Jira admin, audit). Real endpoints are always called for real.
# See frontend/docs/phase7-api-gaps.md.
VITE_DEMO_MODE=true
VITE_ORG_NAME=NovaTech

# ---- AI service -----------------------------------------------------------
# Blank provider keys select the deterministic mock provider, so the demo runs
# identically offline.
AI_SERVICE_PORT=8000
LLM_PROVIDER=auto
GEMINI_API_KEY=
DEMO_MODE=true
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_SERVICE_TOKEN=dev-only-service-token-change-me
AI_LOG_LEVEL=INFO

# ---- Jira Cloud -----------------------------------------------------------
# Leave blank to keep the feature disabled. The rest of the platform still works.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# ---- MCP adapter (Phase 9) -----------------------------------------------
# Optional. Start with: docker compose --profile mcp up --build
MCP_HTTP_PORT=9000
SMARTWORK_API_BASE_URL=http://backend:8080/api/v1
MCP_REQUEST_TIMEOUT_SECONDS=10
MCP_LOG_LEVEL=INFO
